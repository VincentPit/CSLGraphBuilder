# ── GraphBuilder API ─────────────────────────────────────────────────────────
# Multi-stage build: builder → runtime.
#
# This image is CPU-only — sentence-transformers pulls a CPU build of torch
# from PyPI on `python:3.11-slim`, so the embedding stack runs through the
# single-worker asyncio.Lock + executor path. The GPU embedding pool
# (gpu_embedding_pool.py) detects CUDA at first use and stays disabled
# here, falling through to the CPU path.
#
# To run with the GPU pool active:
#   1. Switch the base image to nvidia/cuda:12.1-cudnn-runtime-ubuntu22.04
#      (or matching CUDA version for your host driver) and install Python
#      3.11 + the same requirements.
#   2. Replace `pip install` of torch (transitive) with the CUDA-enabled
#      build: `pip install torch --index-url https://download.pytorch.org/whl/cu121`
#   3. Add `runtime: nvidia` (or the modern `deploy.resources.reservations.devices`
#      block) to the api service in docker-compose.yml so the container
#      can see the GPU.
# The EMBEDDING_GPU_* env vars in docker-compose.yml are already wired
# through and will become live once those changes land.

FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml requirements.txt ./
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir fastapi uvicorn[standard] python-multipart sse-starlette

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

RUN groupadd -g 1002 apiuser && useradd -u 1002 -g apiuser -m -s /bin/bash apiuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source
COPY src/ ./src/
COPY api/ ./api/

RUN chown -R apiuser:apiuser /app
USER apiuser

EXPOSE 8000

ENTRYPOINT ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
